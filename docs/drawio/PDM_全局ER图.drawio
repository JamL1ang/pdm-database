<mxfile host="app.diagrams.net" modified="2026-11-07T11:33:34" agent="PDM-CourseDesign" version="24.7.5" type="device"><diagram id="全局 E-R 图" name="全局 E-R 图"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="C1 产品数据管理（PDM）数字化系统 · 全局 E-R 图" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1E4FA8;" vertex="1" parent="1"><mxGeometry x="260" y="20" width="660" height="34" as="geometry"/></mxCell><mxCell id="n" value="图例：蓝框=实体（表名下为 PK / 主属性）  绿框=M:N 中间表  连线上的 1 / N 为基数  带下划线的 id 为主键" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;whiteSpace=wrap;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1090" height="24" as="geometry"/></mxCell><mxCell id="e_product" value="&lt;b&gt;product 产品&lt;/b&gt;&lt;br&gt;PK product_id&lt;br&gt;model / type_name / price" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1A2230;fontSize=13;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="240" height="84" as="geometry"/></mxCell><mxCell id="e_ver" value="&lt;b&gt;product_version 版本&lt;/b&gt;&lt;br&gt;PK version_id&lt;br&gt;FK product_id / version_no" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1A2230;fontSize=13;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="110" width="240" height="84" as="geometry"/></mxCell><mxCell id="e_doc" value="&lt;b&gt;document 设计文档&lt;/b&gt;&lt;br&gt;PK doc_id&lt;br&gt;FK version_id / doc_type / doc_rev" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1A2230;fontSize=13;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="560" y="110" width="240" height="84" as="geometry"/></mxCell><mxCell id="e_comp" value="&lt;b&gt;component 部件&lt;/b&gt;&lt;br&gt;PK component_id&lt;br&gt;component_name / source_type" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1A2230;fontSize=13;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="110" width="240" height="84" as="geometry"/></mxCell><mxCell id="e_mat" value="&lt;b&gt;material 材料&lt;/b&gt;&lt;br&gt;PK material_id&lt;br&gt;material_name / spec" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1A2230;fontSize=13;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="260" width="240" height="84" as="geometry"/></mxCell><mxCell id="e_sup" value="&lt;b&gt;supplier 供应商&lt;/b&gt;&lt;br&gt;PK supplier_id&lt;br&gt;supplier_name / contact" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1A2230;fontSize=13;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="240" height="84" as="geometry"/></mxCell><mxCell id="e_batch" value="&lt;b&gt;batch 批次&lt;/b&gt;&lt;br&gt;PK batch_id&lt;br&gt;FK product_id / batch_no" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1A2230;fontSize=13;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="420" width="240" height="84" as="geometry"/></mxCell><mxCell id="e_inst" value="&lt;b&gt;product_instance 单台&lt;/b&gt;&lt;br&gt;PK serial_no&lt;br&gt;FK batch_id / product_id" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1A2230;fontSize=13;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="560" y="420" width="240" height="84" as="geometry"/></mxCell><mxCell id="e_user" value="&lt;b&gt;sys_user / sys_role&lt;/b&gt;&lt;br&gt;doc
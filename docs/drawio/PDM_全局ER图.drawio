 source="e_batch" target="r_bcs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l12" value="1 : N  批次事实" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4A5568;strokeWidth=1.5;fontSize=11;fontColor=#1E4FA8;labelBackgroundColor=#FFFFFF;endArrow=none;" edge="1" parent="1" source="e_batch" target="r_bms"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l13" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4A5568;strokeWidth=1.5;fontSize=11;fontColor=#1E4FA8;labelBackgroundColor=#FFFFFF;endArrow=none;" edge="1" parent="1" source="e_comp" target="r_bcs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l14" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4A5568;strokeWidth=1.5;fontSize=11;fontColor=#1E4FA8;labelBackgroundColor=#FFFFFF;endArrow=none;" edge="1" parent="1" source="e_mat" target="r_bms"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l15" value="复合外键约束" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4A5568;strokeWidth=1.5;fontSize=11;fontColor=#1E4FA8;labelBackgroundColor=#FFFFFF;endArrow=none;" edge="1" parent="1" source="r_cs" target="r_bcs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l16" value="复合外键约束" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4A5568;strokeWidth=1.5;fontSize=11;fontColor=#1E4FA8;labelBackgroundColor=#FFFFFF;endArrow=none;" edge="1" parent="1" source="r_ms" target="r_bms"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l17" value="授权读写" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4A5568;strokeWidth=1.5;fontSize=11;fontColor=#1E4FA8;labelBackgroundColor=#FFFFFF;endArrow=none;" edge="1" parent="1" source="e_user" target="e_doc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n2" value="说明：可供清单（谁能供）与批次供货源（这批实际用了谁）分离，联合主键保证同批同物料只有一家供应商，复合外键保证必须来自已登记可供清单。" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;whiteSpace=wrap;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="1090" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>